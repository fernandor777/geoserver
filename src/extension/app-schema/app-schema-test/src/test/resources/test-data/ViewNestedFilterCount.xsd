<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://example.com" xmlns:ex="http://example.com"
    xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

    <xs:import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="http://schemas.opengis.net/gml/3.2.1/gml.xsd" />

    <xs:element name="ViewParentFeature" type="ex:ViewParentFeatureType"
        substitutionGroup="gml:AbstractFeature" />
    <xs:element name="ViewFirstNestedFeature" type="ex:ViewFirstNestedFeatureType"
        substitutionGroup="gml:AbstractFeature" />
    <xs:element name="ViewSecondNestedFeature" type="ex:ViewSecondNestedFeatureType"
        substitutionGroup="gml:AbstractFeature" />

    <xs:complexType name="ViewParentFeatureType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                    <xs:element name="nestedFeature" type="ex:ViewFirstNestedFeaturePropertyType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="ViewFirstNestedFeatureType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                    <xs:element name="nestedFeature" type="ex:ViewSecondNestedFeaturePropertyType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="ViewSecondNestedFeatureType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="ViewFirstNestedFeaturePropertyType">
        <xs:sequence minOccurs="0">
            <xs:element ref="ex:ViewFirstNestedFeature" />
        </xs:sequence>
        <xs:attributeGroup ref="gml:AssociationAttributeGroup" />
        <xs:attributeGroup ref="gml:OwnershipAttributeGroup" />
    </xs:complexType>

    <xs:complexType name="ViewSecondNestedFeaturePropertyType">
        <xs:sequence minOccurs="0">
            <xs:element ref="ex:ViewSecondNestedFeature" />
        </xs:sequence>
        <xs:attributeGroup ref="gml:AssociationAttributeGroup" />
        <xs:attributeGroup ref="gml:OwnershipAttributeGroup" />
    </xs:complexType>

</xs:schema>
