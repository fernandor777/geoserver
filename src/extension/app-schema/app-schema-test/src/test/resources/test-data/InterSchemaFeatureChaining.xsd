<?xml version="1.0" encoding="UTF-8"?>
<xs:schema targetNamespace="http://example.com" xmlns:ex="http://example.com"
    xmlns:gml="http://www.opengis.net/gml/3.2" xmlns:xs="http://www.w3.org/2001/XMLSchema"
    elementFormDefault="qualified" attributeFormDefault="unqualified" version="1.0">

    <xs:import namespace="http://www.opengis.net/gml/3.2"
        schemaLocation="http://schemas.opengis.net/gml/3.2.1/gml.xsd" />

    <xs:element name="InterSchemaParent" type="ex:InterSchemaParentType"
        substitutionGroup="gml:AbstractFeature" />
    <xs:element name="InterSchemaFirstNested" type="ex:InterSchemaFirstNestedType"
        substitutionGroup="gml:AbstractFeature" />
    <xs:element name="InterSchemaSecondNested" type="ex:InterSchemaSecondNestedType"
        substitutionGroup="gml:AbstractFeature" />

    <xs:complexType name="InterSchemaParentType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                    <xs:element name="nestedFeature" type="ex:InterSchemaFirstNestedPropertyType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="InterSchemaFirstNestedType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                    <xs:element name="nestedFeature" type="ex:InterSchemaSecondNestedPropertyType" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="InterSchemaSecondNestedType">
        <xs:complexContent>
            <xs:extension base="gml:AbstractFeatureType">
                <xs:sequence>
                    <xs:element ref="gml:name" minOccurs="0" />
                </xs:sequence>
            </xs:extension>
        </xs:complexContent>
    </xs:complexType>

    <xs:complexType name="InterSchemaFirstNestedPropertyType">
        <xs:sequence minOccurs="0">
            <xs:element ref="ex:InterSchemaFirstNested" />
        </xs:sequence>
        <xs:attributeGroup ref="gml:AssociationAttributeGroup" />
        <xs:attributeGroup ref="gml:OwnershipAttributeGroup" />
    </xs:complexType>

    <xs:complexType name="InterSchemaSecondNestedPropertyType">
        <xs:sequence minOccurs="0">
            <xs:element ref="ex:InterSchemaSecondNested" />
        </xs:sequence>
        <xs:attributeGroup ref="gml:AssociationAttributeGroup" />
        <xs:attributeGroup ref="gml:OwnershipAttributeGroup" />
    </xs:complexType>

</xs:schema>
